# Copia este archivo a .env (que está en .gitignore) y rellena los valores.
# NUNCA subas el .env ni las claves al repositorio.
QR_API_PORT=8080

# Usuario demo para POST /auth/login
DEMO_USER=reviewer
DEMO_PASSWORD=cambia-esta-contraseña

# Par de claves RSA para los JWT (RS256), en base64 de una sola línea.
# Genéralas así:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl pkey -in jwt.key -pubout -out jwt.pub
#   JWT_PRIVATE_KEY=$(base64 -w0 jwt.key)              # Linux
#   JWT_PUBLIC_KEY=$(base64 -w0 jwt.pub)
#   JWT_PRIVATE_KEY=$(base64 -i jwt.key | tr -d "\n")   # macOS (no tiene -w0)
#   JWT_PUBLIC_KEY=$(base64 -i jwt.pub | tr -d "\n")
# La privada solo la usa la API Go; Node recibe únicamente la pública.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
